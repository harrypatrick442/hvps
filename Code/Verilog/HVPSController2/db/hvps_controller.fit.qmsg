are" 0 -1 1771076729168 ""} { "Error" "EFIOMGR_IO_BANK_OUTPUTS_VCCIO_INCOMPATIBLE" "U20_INV_CS 6 2.5 V 2.5V 3.3V " "Pin U20_INV_CS with I/O standard assignment 2.5 V is incompatible with I/O bank 6. I/O standard 2.5 V, has a VCCIO requirement of 2.5V, which incompatible with the I/O bank's VCCIO setting or with other output or bidirectional pins in the I/O bank using a VCCIO requirement of 3.3V. Assign output and bidirectional pins with different VCCIO requirements to different I/O banks, or change the I/O standard assignment for the specified pin to a compatible I/O standard. The Intel FPGA Knowledge Database contains many articles with specific details on how to resolve this error. Visit the Knowledge Database at https://www.altera.com/support/support-resources/knowledge-base/search.html and search for this specific error message number." { { "Info" "IFIOMGR_PIN_OF_PARTITION_IN_BANK_USES_VCCIO" "Top 2 6 3.3V " "Design partition \"Top\" has 2 pin(s) in the I/O bank 6 and the pins(s) use VCCIO 3.3V" { { "Info" "IFIOMGR_PIN_IN_BANK_USES_VCCIO" "U12_INV_EOC 6 3.3V " "Pin U12_INV_EOC in I/O bank 6 uses VCCIO 3.3V" {  } { { "d:/altera_lite/25.1std/quartus/bin64/pin_planner.ppl" "" { PinPlanner "d:/altera_lite/25.1std/quartus/bin64/pin_planner.ppl" { U12_INV_EOC } } } { "d:/altera_lite/25.1std/quartus/bin64/Assignment Editor.qase" "" { Assignment "d:/altera_lite/25.1std/quartus/bin64/Assignment Editor.qase" 1 { { 0 "U12_INV_EOC" } } } } { "hvps_controller.v" "" { Text "C:/repos/hvps/Code/Verilog/HVPSController2/hvps_controller.v" 4 0 0 } } { "temporary_test_loc" "" { Generic "C:/repos/hvps/Code/Verilog/HVPSController2/" { { 0 { 0 ""} 0 4 14177 15141 0 0 "" 0 "" "" }  }  } }  } 0 169073 "Pin %1!s! in I/O bank %2!s! uses VCCIO %3!s!" 0 0 "Design Software" 0 -1 1771076729168 ""} { "Info" "IFIOMGR_PIN_IN_BANK_USES_VCCIO" "clk 6 3.3V " "Pin clk in I/O bank 6 uses VCCIO 3.3V" {  } { { "d:/altera_lite/25.1std/quartus/bin64/pin_planner.ppl" "" { PinPlanner "d:/altera_lite/25.1st